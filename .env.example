# Fake values only. Copy to .env and fill in locally. Never commit .env.

# Postgres (matches docker-compose.yml)
POSTGRES_USER=seyvixa
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=seyvixa
POSTGRES_PORT=5432
DATABASE_URL=postgresql://seyvixa:change-me-locally@localhost:5432/seyvixa

# Demo owner login (checked by the session login, not stored in the database). The API refuses a value that is
# missing, still starts with REPLACE_ME, or (for the password) is shorter than 12 characters. Set your own in .env.
DEMO_OWNER_LOGIN=REPLACE_ME_demo_owner_login
DEMO_OWNER_PASSWORD=REPLACE_ME_demo_owner_password

# Agent credentials. Only their SHA-256 is stored in agents.credential_hash. The seed refuses a value that
# is missing, shorter than 32 characters or still starts with REPLACE_ME. Make your own in .env with:
#   node -e "console.log('sva_' + require('node:crypto').randomBytes(32).toString('base64url'))"
PROCUREMENT_AGENT_CREDENTIAL=REPLACE_ME_with_a_generated_token
FINANCE_AGENT_CREDENTIAL=REPLACE_ME_with_a_generated_token

# Server key for the HMAC integrity tag on agent grants (fake value)
GRANT_INTEGRITY_KEY=fake-grant-integrity-key-change-me

# Cardano testnet and chain-data API (T6.1, fake values; Preprod only)
CARDANO_NETWORK=preprod
BLOCKFROST_PROJECT_ID=fake-blockfrost-preprod-project-id-change-me

# Preprod wallet mnemonic for manual testnet transactions (T6.4, fake placeholder; 24 space-separated words). Never commit real mnemonic.
PREPROD_WALLET_MNEMONIC="replace me with your 24 word preprod wallet seed phrase"

# services/chain (T7.1). Prototype setting (team decision D18): block confirmations needed before a tx counts as confirmed.
CONFIRMATION_DEPTH=3
# Optional, for the live Preprod test only: a public Preprod transaction id (64 hex chars). Leave empty to skip it.
CHAIN_TEST_KNOWN_TX_ID=

# Receipt-signing Ed25519 private key (T8.2, Blueprint Section 6.8). Fake placeholder only — never commit the real key.
RECEIPT_SIGNING_PRIVATE_KEY=REPLACE_ME_with_generated_ed25519_pkcs8_base64url_private_key
